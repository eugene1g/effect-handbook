{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "examples", "runtimes"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "examples": {
      "type": "array",
      "items": { "$ref": "#/$defs/example" }
    },
    "runtimes": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/runtime" }
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "required": ["id", "source", "sha256", "disposition"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "source": {
          "type": "string",
          "pattern": "^docs/.+\\.md$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "disposition": {
          "enum": ["contextual", "run", "pseudocode", "invalid"]
        },
        "fixture": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "runtime": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "diagnostic": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "pattern": "^TS[0-9]+$" },
            "message": { "type": "string", "minLength": 1 }
          }
        },
        "platform": { "type": "string", "minLength": 1 },
        "packages": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "example": {
      "allOf": [
        {
          "$ref": "#/$defs/identity"
        },
        {
          "if": {
            "properties": { "disposition": { "const": "contextual" } },
            "required": ["disposition"]
          },
          "then": { "required": ["fixture"] }
        },
        {
          "if": {
            "properties": { "disposition": { "const": "run" } },
            "required": ["disposition"]
          },
          "then": { "required": ["runtime"] }
        },
        {
          "if": {
            "properties": { "disposition": { "const": "pseudocode" } },
            "required": ["disposition"]
          },
          "then": { "required": ["reason"] }
        },
        {
          "if": {
            "properties": { "disposition": { "const": "invalid" } },
            "required": ["disposition"]
          },
          "then": { "required": ["diagnostic"] }
        }
      ],
      "unevaluatedProperties": false
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "expect"],
      "properties": {
        "mode": { "enum": ["complete", "signal", "doctest"] },
        "exitCode": { "type": "integer", "minimum": 0, "maximum": 255 },
        "expect": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
