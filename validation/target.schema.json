{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "effect", "tools", "toolingExceptions"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "tag", "commit", "publishedAt", "auditedAt"],
      "properties": {
        "version": { "type": "string" },
        "tag": { "type": "string" },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "publishedAt": { "type": "string" },
        "auditedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "pnpm", "typescript", "nodeTypes", "effectTsgo", "vitest", "doctest"],
      "properties": {
        "node": { "type": "string" },
        "pnpm": { "type": "string" },
        "typescript": { "type": "string" },
        "nodeTypes": { "type": "string" },
        "effectTsgo": { "type": "string" },
        "vitest": { "type": "string" },
        "doctest": { "type": "string" }
      }
    },
    "toolingExceptions": { "type": "object", "additionalProperties": { "type": "string" } }
  }
}
